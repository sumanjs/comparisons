{
  "name": "suman-comparisons",
  "version": "0.0.1",
  "description": "Comparisons across testing frameworks",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "suman test",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/comparisons.git"
  },
  "keywords": [
    "suman",
    "testing",
    "comparisons",
    "test",
    "framework",
    "test",
    "library"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/comparisons/issues"
  },
  "homepage": "https://github.com/sumanjs/comparisons#readme",
  "dependencies": {
    "suman": "^1.1.51239"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
